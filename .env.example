# Copy to .env.local and fill in. Never commit .env.local.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser
# (`npm run check:bundle` verifies this after a build).

# Public URL of this deployment. Used for links and for the seeded sandbox
# competitor pages that the Apify Actor scrapes in live mode.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string. On Supabase use the pooled "Transaction" URL
# (port 6543) for Vercel, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledgerlens

# Supabase project keys. LedgerLens talks to Postgres directly through
# DATABASE_URL on the server, so these are optional and currently unused by
# the runtime. Keep the service role key server-only if you set it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI explanations. "anthropic" uses Claude when LLM_API_KEY is set; without a
# key (or with "none") LedgerLens uses deterministic, rules-based narratives.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=60000

# Competitor pricing via Apify. EXTERNAL_INTEL_MODE=live runs the Actor when
# APIFY_TOKEN and APIFY_ACTOR_ID are set; otherwise the labeled demo dataset is used.
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_TIMEOUT_MS=120000
EXTERNAL_INTEL_MODE=fixture

# Demo controls. DEMO_MODE=true shows Reset demo and enables /api/demo/*.
DEMO_MODE=true
DEFAULT_ORGANIZATION_SLUG=acme-outdoor
# Pause between investigation steps so the live timeline is readable (ms).
INVESTIGATION_STEP_DELAY_MS=450
LOG_LEVEL=info
