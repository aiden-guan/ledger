# ---------------------------------------------------------------------------
# Next.js app (.env.local). `npx convex dev` writes these two for you.
# The app holds no secrets: it only needs the address of your Convex deployment.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# Convex deployment environment. Do NOT put these in .env.local.
# Set them on the deployment from your own terminal, for example:
#   npx convex env set LLM_API_KEY
#   (the CLI prompts for the value, so it never lands in shell history)
# Production deployments: add --prod.
# ---------------------------------------------------------------------------

# Public URL of the Next.js app. The seeded sandbox competitor pages that the
# Apify Actor scrapes in live mode live under <APP_URL>/market/...
# APP_URL=http://localhost:3000

# AI explanations. "anthropic" uses Claude when LLM_API_KEY is set; without a
# key (or with "none") LedgerLens uses deterministic, rules-based narratives.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_TIMEOUT_MS=60000

# Competitor pricing via Apify. EXTERNAL_INTEL_MODE=live runs the Actor when
# APIFY_TOKEN and APIFY_ACTOR_ID are set; otherwise the labeled demo dataset is used.
# APIFY_TOKEN=
# APIFY_ACTOR_ID=
# APIFY_TIMEOUT_MS=120000
# EXTERNAL_INTEL_MODE=fixture

# Demo controls. DEMO_MODE=true enables Load demo / Reset demo.
# DEMO_MODE=true
# DEFAULT_ORGANIZATION_SLUG=acme-outdoor
# Pause between investigation steps so the live timeline is readable (ms).
# INVESTIGATION_STEP_DELAY_MS=450
# LOG_LEVEL=info
