{
  /* Used by the Convex CLI to typecheck functions before pushing. */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
