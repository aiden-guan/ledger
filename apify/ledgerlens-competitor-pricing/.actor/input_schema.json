{
  "title": "LedgerLens competitor pricing input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "products": {
      "title": "Competitor product pages",
      "type": "array",
      "description": "Pages to visit. Each item: { internalProductId, competitor, url, expectedNameTokens? }. Name tokens reject a redirected or mismatched product.",
      "editor": "json",
      "prefill": [
        { "internalProductId": "daypack-24", "competitor": "Quest Outdoors", "url": "https://www.questoutdoors.com/products/gregory-nano-24", "expectedNameTokens": ["nano", "24"] }
      ]
    },
    "maxConcurrency": {
      "title": "Max concurrency",
      "type": "integer",
      "description": "Parallel page loads.",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": ["products"]
}
